<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskbarTunes</RootNamespace>
    <AssemblyName>TaskbarTunes</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Metadatos del ejecutable (visibles en Propiedades → Detalles) -->
    <Version>1.2.0</Version>
    <Product>TaskbarTunes</Product>
    <AssemblyTitle>TaskbarTunes — music on your taskbar</AssemblyTitle>
    <Copyright>© 2026 ClaudioPenta — GPL-3.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita ambigüedad WPF/WinForms: usamos alias explícitos donde hace falta -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
