<Window x:Class="TaskbarTunes.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TaskbarTunes.Controls"
        Title="TaskbarTunes — Ajustes"
        Width="500" Height="560"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style x:Key="TabPanelStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="14,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="8">

            <!-- ============ APARIENCIA ============ -->
            <TabItem Header="Apariencia">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource TabPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource RowLabel}" Text="Ancho del widget"/>
                            <Slider x:Name="WidthSlider" Grid.Row="0" Grid.Column="1" Minimum="200" Maximum="600" TickFrequency="10"/>
                            <TextBlock x:Name="WidthValue" Grid.Row="0" Grid.Column="2" Style="{StaticResource RowLabel}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" Text="Radio de esquinas"/>
                            <Slider x:Name="CornerSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="24" TickFrequency="1"/>
                            <TextBlock x:Name="CornerValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource RowLabel}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource RowLabel}" Text="Posición"/>
                            <ComboBox x:Name="PositionCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                                <ComboBoxItem Content="Derecha (junto al reloj)"/>
                                <ComboBoxItem Content="Centro"/>
                                <ComboBoxItem Content="Izquierda"/>
                                <ComboBoxItem Content="Personalizada (arrastrada)"/>
                                <ComboBoxItem Content="Overlay libre (flotar sobre apps)"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Style="{StaticResource RowLabel}" Text="Desplazamiento X"/>
                            <Slider x:Name="OffsetSlider" Grid.Row="3" Grid.Column="1" Minimum="-400" Maximum="400" TickFrequency="4"/>
                            <TextBlock x:Name="OffsetValue" Grid.Row="3" Grid.Column="2" Style="{StaticResource RowLabel}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="4" Style="{StaticResource RowLabel}" Text="Alto (modo libre)"/>
                            <Slider x:Name="FreeHeightSlider" Grid.Row="4" Grid.Column="1" Minimum="36" Maximum="96" TickFrequency="2"/>
                            <TextBlock x:Name="FreeHeightValue" Grid.Row="4" Grid.Column="2" Style="{StaticResource RowLabel}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="5" Style="{StaticResource RowLabel}" Text="Color de fondo"/>
                            <controls:ColorPicker x:Name="BgColorPicker" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="6" Style="{StaticResource RowLabel}" Text="Color del texto"/>
                            <controls:ColorPicker x:Name="TextColorPicker" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="7" Style="{StaticResource RowLabel}" Text="Tipografía"/>
                            <ComboBox x:Name="FontCombo" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                            <TextBlock Grid.Row="8" Style="{StaticResource RowLabel}" Text="Tamaño del título"/>
                            <Slider x:Name="FontSizeSlider" Grid.Row="8" Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="0.5"/>
                            <TextBlock x:Name="FontSizeValue" Grid.Row="8" Grid.Column="2" Style="{StaticResource RowLabel}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="9" Style="{StaticResource RowLabel}" Text="Pantalla (modo barra)"/>
                            <ComboBox x:Name="MonitorCombo" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>
                        </Grid>

                        <CheckBox x:Name="AcrylicCheck" Content="Fondo acrílico: desenfoque real de Windows 11 ✨" Margin="0,8,0,0"/>

                        <TextBlock Margin="0,10,0,0" Opacity="0.65" FontSize="11" TextWrapping="Wrap"
                                   Text="💡 También puedes arrastrar el widget con el ratón: por toda la barra (pasa a «Personalizada») o por toda la pantalla en modo overlay libre. Con el acrílico activo, las esquinas las redondea Windows (~8 px)."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ VISUALIZADOR ============ -->
            <TabItem Header="Visualizador">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource TabPanelStyle}">
                        <CheckBox x:Name="ShowVisCheck" Content="Mostrar visualizador"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource RowLabel}" Text="Estilo"/>
                            <ComboBox x:Name="StyleCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                                <ComboBoxItem Content="Barras"/>
                                <ComboBoxItem Content="Barras espejadas"/>
                                <ComboBoxItem Content="Onda"/>
                                <ComboBoxItem Content="Onda rellena"/>
                                <ComboBoxItem Content="Puntos"/>
                                <ComboBoxItem Content="LEDs (ecualizador retro)"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" Text="Número de barras"/>
                            <Slider x:Name="BarsSlider" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="64" TickFrequency="4"/>
                            <TextBlock x:Name="BarsValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource RowLabel}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource RowLabel}" Text="Separación entre barras"/>
                            <Slider x:Name="GapSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="6" TickFrequency="0.5"/>
                            <TextBlock x:Name="GapValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource RowLabel}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="3" Style="{StaticResource RowLabel}" Text="Opacidad"/>
                            <Slider x:Name="OpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="0.05" Maximum="1" TickFrequency="0.05"/>
                            <TextBlock x:Name="OpacityValue" Grid.Row="3" Grid.Column="2" Style="{StaticResource RowLabel}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="4" Style="{StaticResource RowLabel}" Text="Color principal"/>
                            <controls:ColorPicker x:Name="VisColor1Picker" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="5" Style="{StaticResource RowLabel}" Text="Color secundario"/>
                            <controls:ColorPicker x:Name="VisColor2Picker" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="6" Style="{StaticResource RowLabel}" Text="Dirección del degradado"/>
                            <ComboBox x:Name="GradientDirCombo" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                                <ComboBoxItem Content="Vertical"/>
                                <ComboBoxItem Content="Horizontal"/>
                            </ComboBox>

                            <TextBlock Grid.Row="7" Style="{StaticResource RowLabel}" Text="Audio que escucha"/>
                            <ComboBox x:Name="AudioSourceCombo" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                                <ComboBoxItem Content="Solo la app de música (los juegos no lo mueven)"/>
                                <ComboBoxItem Content="Todo el sistema"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="GradientCheck" Content="Usar degradado entre los dos colores"/>
                        <CheckBox x:Name="AdaptiveCheck" Content="Color adaptativo: tomar los colores de la carátula 🎨"/>
                        <CheckBox x:Name="BeatCheck" Content="Modo «beat»: reaccionar solo a los graves 🥁"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ CONTENIDO ============ -->
            <TabItem Header="Contenido">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource TabPanelStyle}">
                        <CheckBox x:Name="ShowArtCheck" Content="Mostrar carátula del álbum"/>
                        <CheckBox x:Name="VinylCheck" Content="Carátula en modo vinilo girando 💿"/>
                        <CheckBox x:Name="CrossfadeCheck" Content="Transición suave al cambiar de carátula"/>
                        <CheckBox x:Name="ClickPanelCheck" Content="Un clic abre el panel expandido (carátula grande, tiempo y seek)"/>
                        <CheckBox x:Name="ShowArtistCheck" Content="Mostrar línea del artista"/>
                        <CheckBox x:Name="ShowControlsCheck" Content="Mostrar controles de reproducción (al pasar el ratón)"/>
                        <CheckBox x:Name="ShowProgressCheck" Content="Mostrar barra de progreso de la canción"/>
                        <CheckBox x:Name="ShowSourceIconCheck" Content="Mostrar icono de la fuente (Spotify / navegador)"/>
                        <CheckBox x:Name="CleanTitlesCheck" Content="Limpiar títulos de YouTube (quitar «Official Video», etc.)"/>
                        <CheckBox x:Name="HideNoMusicCheck" Content="Ocultar el widget cuando no suena nada"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ TEMAS ============ -->
            <TabItem Header="Temas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource TabPanelStyle}">
                        <TextBlock Text="Temas integrados" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="ThemesPanel"/>

                        <TextBlock Text="Mis presets" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <ListBox x:Name="PresetList" Height="110"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="ApplyPresetButton" Content="Aplicar" Width="90" Margin="0,0,8,0" Click="OnApplyPreset"/>
                            <Button x:Name="DeletePresetButton" Content="Eliminar" Width="90" Click="OnDeletePreset"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBox x:Name="PresetNameBox" Width="220" VerticalContentAlignment="Center"/>
                            <Button Content="Guardar configuración actual" Margin="8,0,0,0" Padding="10,2" Click="OnSavePreset"/>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Opacity="0.65" FontSize="11" TextWrapping="Wrap"
                                   Text="Un preset guarda la apariencia (colores, visualizador, tipografía), no la posición ni el comportamiento."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ SISTEMA ============ -->
            <TabItem Header="Sistema">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource TabPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource RowLabel}" Text="Fuente de música"/>
                            <ComboBox x:Name="SourceCombo" Grid.Column="1" Margin="0,4">
                                <ComboBoxItem Content="Automática (la que esté sonando)"/>
                                <ComboBoxItem Content="Spotify"/>
                                <ComboBoxItem Content="Navegador (YouTube, Spotify Web…)"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" Text="Doble clic en el widget"/>
                            <ComboBox x:Name="DoubleClickCombo" Grid.Row="1" Grid.Column="1" Margin="0,4">
                                <ComboBoxItem Content="Nada"/>
                                <ComboBoxItem Content="Reproducir / Pausar"/>
                                <ComboBoxItem Content="Abrir la app de música"/>
                                <ComboBoxItem Content="Abrir Ajustes"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="AutoStartCheck" Content="Iniciar TaskbarTunes con Windows" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Margin="16,0,16,10" Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                   Text="Los cambios se aplican al momento y se guardan automáticamente."/>
    </Grid>
</Window>
