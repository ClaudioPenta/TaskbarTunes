<Window x:Class="TaskbarTunes.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarTunes"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="360" SizeToContent="Height"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <Style x:Key="FlyMediaButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="FlyRoot" CornerRadius="12" Background="#F0202020"
            BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16,14">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="88" Height="88" CornerRadius="8" Background="#28FFFFFF">
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Width="88" Height="88" CornerRadius="8" Background="Black"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                    <Grid>
                        <Image x:Name="FlyArt" Stretch="UniformToFill"/>
                        <TextBlock x:Name="FlyArtPlaceholder" Text="&#xE93C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="32" Foreground="White" Opacity="0.6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FlyTitle" Text="Sin reproducción"
                               FontSize="14.5" FontWeight="SemiBold" Foreground="White"
                               TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FlyArtist" Text="" Margin="0,3,0,0"
                               FontSize="12" Foreground="White" Opacity="0.75"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FlySource" Text="" Margin="0,2,0,0"
                               FontSize="10.5" Foreground="White" Opacity="0.5"/>
                </StackPanel>
            </Grid>

            <Slider x:Name="SeekSlider" Margin="0,14,0,0"
                    Minimum="0" Maximum="1" IsMoveToPointEnabled="True"/>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PosText" Text="0:00" FontSize="10.5"
                           Foreground="White" Opacity="0.7" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="FlyPrev" Style="{StaticResource FlyMediaButton}"
                            Content="&#xE892;" Click="OnPrev" ToolTip="Anterior"/>
                    <Button x:Name="FlyPlay" Style="{StaticResource FlyMediaButton}"
                            Content="&#xE768;" FontSize="17" Margin="8,0" Click="OnPlayPause" ToolTip="Reproducir/Pausar"/>
                    <Button x:Name="FlyNext" Style="{StaticResource FlyMediaButton}"
                            Content="&#xE893;" Click="OnNext" ToolTip="Siguiente"/>
                </StackPanel>

                <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" FontSize="10.5"
                           Foreground="White" Opacity="0.7" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
